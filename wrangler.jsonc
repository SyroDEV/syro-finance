
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "syro-finance",

  "main": "src/worker.py",

  "compatibility_date": "2026-10-02",

  "compatibility_flags": [
    "python_workers"
  ],

  "workers_dev": true,

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
